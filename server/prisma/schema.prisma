generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  USER
  ADMIN
  DOCTOR
}

model User {
  id              String              @id @default(cuid())
  firstname       String?
  lastname        String?
  username        String              @unique
  email           String              @unique
  password        String?
  googleId        String?             @unique
  authProvider    String?
  avatarUrl       String?
  emailVerified   Boolean             @default(false)
  role            Role                @default(USER)
  plan            String              @default("Free")
  premiumActivatedAt DateTime?
  premiumExpiresAt   DateTime?
  dob             String?
  gender          String?
  height          String?
  weight          String?
  bloodGroup      String?
  country         String?
  phone           String?
  conditions      String[]            @default([])
  otherConditions String?
  allergies       String[]            @default([])
  medications     String?
  smokes          Boolean?
  alcohol         Boolean?
  exercises       Boolean?
  emergName       String?
  emergPhone      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  triageRecords   TriageRecord[]
  achievements    Achievement[]
  resetCodes      PasswordResetCode[]
  doctorProfile   DoctorProfile?
  aiUsage         AIUsage[]
  panicEvents     PanicEvent[]
  doctorConversations   Conversation[] @relation("DoctorConversations")
  patientConversations  Conversation[] @relation("PatientConversations")
  reviewsReceived       DoctorReview[] @relation("DoctorReviewsReceived")
  reviewsGiven          DoctorReview[] @relation("DoctorReviewsGiven")
  doctorAppointments    Appointment[]  @relation("DoctorAppointments")
  patientAppointments   Appointment[]  @relation("PatientAppointments")
  vitalReadings         VitalReading[]
  payments              Payment[]
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  txRef           String    @unique
  amount          Float
  currency        String
  planType        String    // monthly | yearly
  status          String    @default("PENDING") // PENDING | SUCCESSFUL | FAILED
  flwTransactionId String?
  createdAt       DateTime  @default(now())
  verifiedAt      DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TriageRecord {
  id          String   @id @default(cuid())
  userId      String
  symptoms    String
  triageLevel String
  triageTitle String?
  summary     String?
  confidence  Float?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Achievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model PanicEvent {
  id                String   @id @default(cuid())
  userId            String
  startedAt         DateTime
  endedAt           DateTime @default(now())
  durationSeconds   Int?
  groundingComplete Boolean  @default(false)
  usedCalmingSound  Boolean  @default(false)
  note              String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AIUsage {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model WaitlistEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model DoctorProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  fullName          String
  phone             String
  licenseNumber     String
  issuingAuthority  String
  specialty         String
  yearsExperience   Int
  hospital          String?
  bio               String?
  licenseDocument   String?   @db.Text
  latitude          Float?
  longitude         Float?
  formattedAddress  String?
  isAvailable       Boolean   @default(true)
  verificationStatus String   @default("PENDING")
  rejectionReason   String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

model DoctorReview {
  id             String   @id @default(cuid())
  doctorId       String
  patientId      String
  rating         Int      // 1-5
  comment        String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  doctor         User     @relation("DoctorReviewsReceived", fields: [doctorId], references: [id], onDelete: Cascade)
  patient        User     @relation("DoctorReviewsGiven", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorId, patientId])
  @@index([doctorId])
}

model VitalReading {
  id        String   @id @default(cuid())
  userId    String
  heartRate String?
  spo2      String?
  temp      String?
  bp        String?
  glucose   String?
  weight    String?
  source    String   @default("manual") // manual | camera
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Appointment {
  id            String   @id @default(cuid())
  doctorId      String
  patientId     String
  scheduledDate String   // e.g. "2026-09-01" — kept as free text to match the existing date/time inputs
  scheduledTime String   // e.g. "14:30"
  reason        String?  @db.Text
  urgency       String   @default("Routine") // Routine | Soon | Urgent
  status        String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED
  declineReason String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  doctor        User     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  patient       User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([patientId])
}

model Conversation {
  id        String    @id @default(cuid())
  doctorId  String
  patientId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  doctor    User      @relation("DoctorConversations", fields: [doctorId], references: [id], onDelete: Cascade)
  patient   User      @relation("PatientConversations", fields: [patientId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([doctorId, patientId])
  @@index([doctorId])
  @@index([patientId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     String       // DOCTOR | USER
  content        String       @db.Text
  imageData      String?      @db.Text // base64 data URI, resized/compressed client-side
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}